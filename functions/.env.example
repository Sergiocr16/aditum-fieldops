# © 2026 Aditum — Aditum Service (Functions). Copy to .env (gitignored).
# Non-sensitive config only. Secrets must use `firebase functions:secrets:set`.
FUNCTIONS_REGION=us-central1

# Email notifications (Gmail SMTP). Secrets (NOT here): SMTP_USER, SMTP_PASS via
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS   (Gmail App Password de 16 caracteres)
ADMIN_NOTIFY_EMAIL=partners@aditumcr.com
APP_URL=https://fieldops-aditum.web.app
# Remitente visible. Debe ser la cuenta autenticada (SMTP_USER) o un alias "Enviar como"
# verificado en esa cuenta. Ej: service@aditumcr.com (alias verificado de partners@).
# SMTP_FROM=service@aditumcr.com
