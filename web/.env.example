# © 2026 Aditum — Aditum FieldOps (web). Copy to .env and fill with your Firebase web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=us-central1
# Public base URL used to build shareable links (e.g. https://aditum-fieldops.web.app)
VITE_PUBLIC_BASE_URL=
# Set to 'true' to use local Firebase emulators during development
VITE_USE_EMULATORS=false
